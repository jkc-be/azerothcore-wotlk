# Point at your local AzerothCore stack (auth + world + MySQL).
# Stock AC / CI use acore:acore (see worldserver.conf.dist).
E2E_AUTH_ADDR=127.0.0.1:3724
E2E_AUTH_DSN=acore:acore@tcp(127.0.0.1:3306)/acore_auth
E2E_CHAR_DSN=acore:acore@tcp(127.0.0.1:3306)/acore_characters
E2E_WORLD_DSN=acore:acore@tcp(127.0.0.1:3306)/acore_world

# Optional filters (see internal/meta)
# E2E_TAGS=smoke,short
# E2E_SKIP_TAGS=long
# E2E_ISSUE=26549
# E2E_RUNTIME=short

# Optional mod-alles suite: pre-provisioned disposable owners on an exclusive configured realm.
# See suites/alles/README.md; ordinary suites skip it without this manifest.
# E2E_ALLES_FIXTURE=/absolute/path/to/e2e/local/alles-fixture.json
# Optional unmanaged-human/privileged-local-chat regression; see the same suite README.
# E2E_ALLES_AUDIENCE_FIXTURE=/absolute/path/to/e2e/local/alles-audience-fixture.json

# Optional live model conversation/action fixture with exact disposable observer and two existing bots.
# E2E_ALLES_CONVERSATION_FIXTURE=/absolute/path/to/e2e/local/alles-conversation-fixture.json
