[worldserver]

# Optional memory-bearing village module. Requires static mod-playerbots linkage.
# The schema is required whenever mod-alles is compiled, including when disabled here.
Alles.Enable = 0

# First-light cohort: exact typed character IDs, including the human's character.
# Example syntax only: player:42,player:43,player:44,player:45,player:46,player:47
# No accounts are created or changed by this configuration. NPC owners require the later W7 adapter.
Alles.Owners = ""

# Use pilot on the ordinary realm; simulation requires isolated Observatory mode and its acceptance checks.
# Use bridge for the external agent worker. Simulation keeps Alles.Telemetry.Directory empty.
Alles.Worker.Mode = "inprocess-fake"
Alles.SchedulingProfile = "pilot"
# Withhold fake replies to exercise normal permit/lease/deadline fallback (the earliest expiry wins).
Alles.Worker.FakeWithhold = 0

Alles.Memory.MaxMemories = 256
Alles.Memory.MaxPerceptions = 128
Alles.Memory.HearsayCap = "0.6"
Alles.Memory.HalfLifeSeconds = 86400
Alles.WitnessRange = 40

Alles.Speech.Enable = 1
Alles.Speech.CooldownSeconds = 30
Alles.Speech.RepeatSeconds = 300

# Bounds older-future waits and admission of final DB calls. An admitted core synchronous call
# cannot currently be cancelled; this is not a hard maximum worldserver shutdown duration.
Alles.Shutdown.DrainSeconds = 10

# External agent worker: authenticated loopback, shared fair queues, one model attempt per job.
# Set Mode=bridge and all paths/profile fields explicitly after running the worker's offline fixtures.
Alles.Worker.Port = 8779
Alles.Worker.TokenFile = ""
Alles.Worker.Model = ""
# SHA256 printed by apps/alles worker --config FILE --fingerprint.
Alles.Worker.Profile = ""
# Durable trial file: restarting either process never resets its charged request count.
Alles.Interpreter.TrialLedger = ""
Alles.Interpreter.TrialMaxRequests = 100
# Existing private directory, served read-only by the Observatory bridge (ordinary realm only).
Alles.Telemetry.Directory = ""
# Journals written beside latest.json for the dashboard's event feed and reconnect history: events.ndjson
# (bot actions, XP, deaths, quest rewards, perceptions, memories, speech, store and worker state) and
# snapshots.ndjson. A journal is renamed NAME.NNNNNN.ndjson once it reaches this many bytes so the bridge
# can prune old segments; 0 keeps one growing file per journal, otherwise at least 1 MiB. At startup the
# previous run's journals and the bridge's derived files move to archive/<run>/ inside the directory.
Alles.Telemetry.JournalSegmentBytes = 67108864

# Natural local conversation is separate from memory formation and ambient memory retelling.
# Requires bridge mode. Every eligible nearby autonomous bot may respond; direct naming limits the audience.
Alles.Conversation.Enable = 0

# "limited": real-minute model allowance; "unlimited": no rate throttle; "trial": explicit finite test.
# The legacy "rolling" spelling remains accepted. Concurrency and queue bounds apply in every mode.
# Use a new profile-matched ledger for a changed model/prompt contract; preserve old trial evidence.
Alles.Interpreter.BudgetMode = "limited"
Alles.Interpreter.RequestsPerMinute = 30
# Objective execution is opt-in while exploration, cooperation and persistence are being integrated.
# Uses the active New RPG engine; incompatible strategy sets suspend objective execution.
Alles.Objectives.Enable = 0

# Provisional measurement defaults; tune using waiting ages and outcomes, not provider assumptions.
Alles.Interpreter.ConcurrentJobs = 1
Alles.Interpreter.ConcurrentCalls = 1
Alles.Interpreter.WaitingPerActor = 2
Alles.Interpreter.WaitingGlobal = 10
Alles.Interpreter.BytesPerActor = 49152
Alles.Interpreter.BytesGlobal = 245760
# Empty uses TrialLedger + ".policy.json". Durable runtime overrides win over the startup defaults.
Alles.Interpreter.PolicyFile = ""
# Separate private 32-128 byte token, different from Worker.TokenFile. Empty disables dashboard controls/interviews.
Alles.Interpreter.ControlTokenFile = ""
# Observer evidence only; room for the worker prompt and live quest/intentions snapshot is reserved separately.
Alles.Interview.EvidenceBytes = 6144
